# Copy this file to .env and fill in your keys
# Never commit .env to GitHub!

# Required: Your OpenAI API key (get from https://platform.openai.com)
OPENAI_API_KEY=sk-your-key-here

# Optional: Use Anthropic Claude instead of OpenAI
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: Serper API for web search (free tier available at https://serper.dev)
# SERPER_API_KEY=your-serper-key-here
